[Unit]
Description=pikiosk daemon
After=network.target NetworkManager.service
StartLimitIntervalSec=0

[Service]
User=@KIOSK_USER@
EnvironmentFile=/etc/default/pikiosk
# PIKIOSK_RELEASES: the GitHub repo checked for new releases.
EnvironmentFile=-/etc/default/pikiosk-update
ExecStart=/usr/local/bin/kioskd
Type=notify
NotifyAccess=main
WatchdogSec=90
# After a watchdog abort, do not wait for every Chromium process to dump core.
TimeoutAbortSec=10
Restart=always
RestartSec=3
StateDirectory=pikiosk
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
