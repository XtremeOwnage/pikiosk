{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Netdocs": {
    "siteName": "pikiosk",
    "siteAuthor": "XtremeOwnage",
    "siteUrl": "https://xtremeownage.github.io/pikiosk/",
    "siteDescription": "A Raspberry Pi wall display controlled from Home Assistant over MQTT and REST, with no cloud.",
    "repoUrl": "https://github.com/XtremeOwnage/pikiosk",
    "repoName": "XtremeOwnage/pikiosk",
    "editUri": "edit/main/docs-site/docs/",
    "docsDir": "docs",
    "siteDir": "site",
    "theme": {
      "name": "material",
      "language": "en",
      "font": {
        "text": "Roboto",
        "code": "Roboto Mono"
      },
      "palette": [
        {
          "scheme": "slate",
          "primary": "blue",
          "accent": "blue",
          "toggle": {
            "icon": "material/brightness-4",
            "name": "Switch to light mode"
          }
        },
        {
          "scheme": "default",
          "primary": "blue",
          "accent": "blue",
          "toggle": {
            "icon": "material/brightness-7",
            "name": "Switch to dark mode"
          }
        }
      ],
      "features": [
        "navigation.tabs",
        "navigation.sections",
        "navigation.top",
        "navigation.footer",
        "navigation.indexes",
        "navigation.path",
        "search.suggest",
        "search.highlight",
        "content.code.copy",
        "content.action.edit",
        "content.tabs.link",
        "content.tooltips",
        "toc.follow"
      ]
    },
    "nav": [
      { "title": "Home", "path": "index.md", "icon": "home" },
      {
        "title": "Getting started",
        "icon": "rocket-launch",
        "children": [
          { "path": "getting-started/installation.md" },
          { "path": "getting-started/first-setup.md" }
        ]
      },
      {
        "title": "Guides",
        "icon": "book-open-page-variant",
        "children": [
          { "path": "guides/views.md" },
          { "path": "guides/rotations.md" },
          { "path": "guides/home-assistant.md" },
          { "path": "guides/single-sign-on.md" },
          { "path": "guides/sound-and-casting.md" },
          { "path": "guides/display-and-sleep.md" }
        ]
      },
      {
        "title": "Operations",
        "icon": "wrench",
        "children": [
          { "path": "operations/updating.md" },
          { "path": "operations/remote-access.md" },
          { "path": "operations/watchdogs.md" },
          { "path": "operations/offline.md" },
          { "path": "operations/troubleshooting.md" }
        ]
      },
      {
        "title": "Reference",
        "icon": "book-open-variant",
        "children": [
          { "path": "reference/mqtt.md" },
          { "path": "reference/rest-api.md" },
          { "path": "reference/configuration.md" },
          { "path": "reference/nixos.md" }
        ]
      },
      { "title": "Development", "path": "development.md", "icon": "code-braces" },
      { "title": "Changelog", "path": "changelog.md", "icon": "history" }
    ],
    "plugins": [
      { "name": "search", "options": { "lang": "en" } },
      { "name": "meta" },
      { "name": "glightbox" }
    ],
    "validation": {
      "links": true,
      "anchors": true,
      "orphanPages": true
    },
    "markdownExtensions": [
      { "name": "admonition" },
      { "name": "pymdownx.details" },
      { "name": "attr_list" },
      { "name": "toc", "options": { "permalink": true } },
      { "name": "pymdownx.tabbed", "options": { "alternate_style": true } },
      { "name": "pymdownx.superfences" }
    ],
    "extra": {
      "social": [
        { "icon": "fontawesome/brands/github", "link": "https://github.com/XtremeOwnage/pikiosk" }
      ]
    }
  }
}
